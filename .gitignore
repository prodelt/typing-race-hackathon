# Local agent scratch — only the wayfinder map and its tickets are published
.tasks/
.scratch/*
!.scratch/typing-race-hackathon/

# Third-party skill copies and cloned reference repos.
# Restore with skills-lock.json (Matt Pocock skills) and `specify init` (Spec Kit).
.agents/skills/
.claude/skills/
.claude/worktrees/
.claude/settings.local.json
/skills/
/spec-kit/

# Organizer snapshot: REVIEW_REQUIRED content, cloned separately, never committed
/tasks/

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts and cache
dist/
build/
.cache/
.vite/
.rolldown/
*.log

# Test artifacts
coverage/
playwright-report/
blob-report/
test-results/
*.tsbuildinfo

# Playwright's downloaded browsers, if ever pointed inside the repository
.playwright/

# Environment variables — only .env.example is committed
.env
.env.*
!.env.example

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Paraglide compiler output — generated at build time from apps/web/messages/
apps/web/src/paraglide/

# Supabase local state — only migrations, functions, seed and config are tracked
supabase/.branches/
supabase/.temp/
